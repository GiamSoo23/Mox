# Patterns are path-independent so they keep working if folders move.

# OS / editors
.DS_Store
.vscode/
.idea/
*.iml

# Secrets and machine-specific config
.env
local.properties

# Swift / SwiftPM / Xcode
.build/
.swiftpm/
*.xcodeproj/
Package.resolved
Mox.app/

# Android / Gradle
.gradle/
build/
captures/
.cxx/
*.apk
*.aab
