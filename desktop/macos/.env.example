# Developer configuration for Mox on macOS. Copy to .env and fill it in.
# Normally Mox keeps these in the Keychain; a .env is read at launch from
# $MOX_ENV, ~/.config/mox/.env, the current directory, or the app bundle.
# Never commit a filled-in .env.

# Your Supabase project (Project Settings → API Keys). Publishable key only,
# never the secret one.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Mox user that owns Mox in your project (backend/README.md,
# "Making yourself the owner").
MOX_USER_EMAIL=mox-xxxxxxxx@mox.invalid
MOX_USER_PASSWORD=a-long-random-password

# Optional
# MOX_HOTKEY=cmd+shift+m
# MOX_POLL_SECONDS=5
# The Mox OAuth app's secret, for "Sign in with Supabase" in the setup
# window. Official builds carry it; without it, setup uses an access token.
# MOX_OAUTH_CLIENT_SECRET=
