<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app: icon, menu, notifications, hotkey, Explorer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on macOS and Linux too, for CI and editors. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Mox.Tray</RootNamespace>
    <AssemblyName>Mox</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>mox.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="mox.ico" LogicalName="mox.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mox.Core\Mox.Core.csproj" />
  </ItemGroup>
  <!-- Official builds carry the Mox OAuth app's secret, so "Sign in with
       Supabase" works (#82, #33). Passed by CI, never committed. -->
  <ItemGroup Condition="'$(MoxOAuthSecret)' != ''">
    <AssemblyMetadata Include="MoxOAuthSecret" Value="$(MoxOAuthSecret)" />
  </ItemGroup>
</Project>
