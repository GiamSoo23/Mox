<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app: icon, menu, notifications, hotkey, Explorer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on macOS and Linux too, for CI and editors. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Mox.Tray</RootNamespace>
    <AssemblyName>Mox</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mox.Core\Mox.Core.csproj" />
  </ItemGroup>
</Project>
