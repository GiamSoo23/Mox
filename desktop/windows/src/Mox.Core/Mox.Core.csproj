<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that doesn't need a screen: the protocol, settings, the
       Supabase client. Plain .NET, so its tests run anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mox.Core</RootNamespace>
  </PropertyGroup>
  <!-- Setup applies these to the user's project (#33). Taken straight from
       backend/, so the Windows app can't carry a stale copy. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\backend\supabase\migrations\*.sql"
                      LogicalName="migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\..\backend\supabase\functions\**\*.ts"
                      Exclude="..\..\..\..\backend\supabase\functions\**\*_test.ts"
                      LogicalName="functions/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
